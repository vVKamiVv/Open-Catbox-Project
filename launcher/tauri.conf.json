{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Catbox",
  "identifier": "io.github.vvkamivv.opencatbox",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Open Catbox",
        "width": 1100,
        "height": 680,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "MPL-2.0",
    "shortDescription": "Launcher for the Open Catbox Project"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwODk0QkEyOTA5MzQxRUIKUldUclFaT1Fva3VKTUF5VTRGd0U2dmpHMVBUS2s1eFAzVGZ6RGlVT2xSelhyQUpsd2lxRDlTU1AK",
      "endpoints": [
        "https://github.com/vVKamiVv/Open-Catbox-Project/releases/latest/download/latest.json"
      ]
    }
  }
}
