{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Catbox",
  "version": "0.1.0",
  "identifier": "io.github.vvkamivv.opencatbox",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Open Catbox",
        "width": 1100,
        "height": 680,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/shin.exe": "shin.exe"
    },
    "copyright": "MPL-2.0",
    "shortDescription": "Launcher for the Open Catbox Project"
  }
}
